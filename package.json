{
  "name": "unity",
  "main": "electron/main.cjs",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "web": "vite --config vite.web.config.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "dist": "vite build && electron-builder",
    "postinstall": "node node_modules/electron/install.js",
    "blockbench:build": "node scripts/build-blockbench.cjs",
    "app:install": "node scripts/install-app.cjs",
    "security:check": "node scripts/security-check.cjs",
    "test": "node --test scripts/test-launch-feedback.cjs scripts/test-cyberpunk-mac.cjs scripts/test-generic-layout.cjs scripts/test-load-order.cjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.21.0",
    "marked": "^18.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "skinview3d": "^3.4.2",
    "three": "^0.185.0",
    "unzipper": "^0.12.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.3.8",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.unitylauncher.launcher",
    "productName": "Unity Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icons/512x512.png",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "45.3.2",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "npmRebuild": false,
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.games"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "scripts/nxm-protocol.nsh"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "unity-launcher"
    },
    "protocols": [
      {
        "name": "Nexus Mods",
        "schemes": [
          "nxm"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "vendor/blockbench",
        "to": "blockbench"
      }
    ]
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  }
}
